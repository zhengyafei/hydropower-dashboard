            "size": 11032,
            "text": "html {\n  overflow: hidden;\n}\n\nbody {\n  margin: 0;\n  position: relative;\n}\n\n.app {\n  width: 100vw;\n  height: 100vh;\n  display: flex;\n}\n\n.rulerCanvas {\n  display: block;\n  height: 100%;\n  width: 100%;\n}\n\n.topRuler {\n  height: 20px;\n  margin-left: 20px;\n}\n\n.leftRuler {\n  width: 20px;\n}\n\n.view {\n  flex: 1;\n  display: none;\n  flex-direction: column;\n}\n\n.networkWrap {\n  display: flex;\n  flex: 1;\n  flex-direction: column;\n  background-color: #202c38;\n}\n\n.canvasWrap {\n  flex: 1;\n  display: flex;\n}\n\n.leftRuler {\n  width: 20px;\n}\n\n.network {\n  flex: 1;\n  height: 100%;\n  position: relative;\n  background-color: #dce5ec;\n}\n\n.chartDom {\n  width: 100%;\n  height: 100%;\n}\n\n.chartWrap {\n  position: absolute;\n  top: 0;\n  left: 0;\n  background-color: #2d3e50;\n  overflow: hidden;\n  transform-origin: 0px 0px;\n  /* resize: both; */\n}\n\n.resizerWrap {\n  width: 10px;\n  height: 10px;\n  position: absolute;\n  right: 0;\n  bottom: 0;\n  border-bottom-color: inherit;\n}\n\n.resizer {\n  border-color: #fff;\n  position: absolute;\n  right: 0;\n  bottom: 0;\n  width: 0;\n  height: 0;\n  border-bottom: 10px solid #fff;\n  border-left: 10px solid transparent;\n  overflow: hidden;\n  background-color: transparent;\n  cursor: nwse-resize;\n}\n\n.resizer2 {\n  border-width: 9px;\n  border-bottom-color: inherit;\n}\n\n.resizer3 {\n  border-width: 5px;\n}\n\n.resizer4 {\n  border-width: 4px;\n  border-bottom-color: inherit;\n}\n\n.controlPanelWrap {\n  /* height: 200px; */\n  background-image: linear-gradient(to right, #181818, #383838, #181818);\n  padding: 0 15px;\n  border-radius: 4px;\n  overflow: hidden;\n  color: #eee;\n}\n.controlPanelWrap .closeButton {\n  float: right;\n}\n#saveControlValue {\n  padding: 0 16px;\n  height: 30px;\n  line-height: 30px;\n  color: #eee;\n  border: none;\n  cursor: pointer;\n  opacity: 0.8;\n  float: right;\n  background-color: #409eff;\n  border-radius: 3px;\n}\n\n.controlRow {\n  display: flex;\n  margin-bottom: 10px;\n  line-height: 30px;\n  justify-content: space-between;\n}\n\n.controlRow.btnRow {\n  display: flow-root;\n}\n\n.controlName {\n  line-height: 30px;\n  margin-right: 15px;\n}\n\n.controlInput {\n  width: 120px;\n  height: 30px;\n  line-height: 30px;\n}\n\n#mask {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background-color: rgba(0, 0, 0, 0.6);\n  z-index: 9999;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n}\n\n.buttonMask {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background-color: rgba(0, 0, 0, 0.7);\n  z-index: 9999;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  flex-direction: column;\n}\n.buttonTitle {\n  color: #ddd;\n}\n.buttonTitle span {\n  display: inline-block;\n  margin: 10px;\n}\n.buttonTitle i {\n  float: right;\n  margin: 10px;\n}\n.buttonPanel .buttonContent {\n  width: 240px;\n  color: #ddd;\n  margin: 10px 15px;\n}\n.buttonPanel .buttonFooter {\n  margin: 10px 15px;\n  display: flex;\n  justify-content: flex-end;\n}\n.buttonPanel .buttonFooter .cancel {\n  padding: 0 16px;\n  margin: 0 10px;\n  border: 1px solid #eee;\n  color: #eee;\n  background: transparent;\n  border-radius: 3px;\n  height: 30px;\n  line-height: 30px;\n  opacity: 0.8;\n}\n.buttonPanel .buttonFooter .confirm {\n  padding: 0 16px;\n  height: 30px;\n  line-height: 30px;\n  color: #eee;\n  border: none;\n  cursor: pointer;\n  opacity: 0.8;\n  float: left;\n  background-color: #409eff;\n  border-radius: 3px;\n}\n\n.buttonPanel {\n  /* width: 160px; */\n  max-width: 280px;\n  /* background-color: #fff; */\n  background-image: linear-gradient(to right, #181818, #383838, #181818);\n  border-radius: 4px;\n}\n\n.buttonPanelBtn {\n  padding: 0 16px;\n  height: 30px;\n  line-height: 30px;\n  color: #fff;\n  border: none;\n  cursor: pointer;\n  margin: 10px;\n  opacity: 0.8;\n  float: left;\n  background-color: #409eff;\n}\n\n.buttonPanelBtn:hover {\n  opacity: 1;\n}\n\n/*\n* 网元tips样式\n*/\n.tips {\n  min-width: 140px;\n  min-height: 37px;\n  border-radius: 10px;\n  box-shadow: 4px 4px 3px rgba(20%, 20%, 40%, 0.5);\n  position: absolute;\n  padding: 10px;\n  background-color: #eee;\n  box-sizing: border-box;\n  display: none;\n  z-index: 999;\n}\n.tips::after {\n  content: \"\";\n  position: absolute;\n  width: 0;\n  height: 0;\n  border-style: solid;\n}\n\n.tips.leftTop::after {\n  border-width: 20px 0 0 15px;\n  border-color: #eee transparent transparent;\n  bottom: -20px;\n  right: 10px;\n  box-shadow: 7px 0px 3px -3px rgba(20%, 20%, 40%, 0.5);\n}\n\n.tips.leftBottom::after {\n  border-width: 0 0 20px 15px;\n  border-color: transparent transparent #eee;\n  top: -20px;\n  right: 10px;\n}\n\n.tips.rightBottom::after {\n  border-width: 20px 0 0 15px;\n  border-color: transparent transparent transparent #eee;\n  top: -20px;\n  left: 10px;\n}\n\n.tips.rightTop::after {\n  border-width: 20px 15px 0 0;\n  border-color: #eee transparent transparent;\n  bottom: -20px;\n  left: 10px;\n  box-shadow: -5px 0px 5px -4px rgba(20%, 20%, 40%, 0.5);\n}\n\n.tipsBody .items {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.tipsBody .items li {\n  position: relative;\n  /* padding-left: 43px; */\n  height: 17px;\n  line-height: 17px;\n  font-size: 14px;\n}\n\n.tipsBody .items li.noData {\n  padding-left: 0;\n  color: #797777;\n}\n\n.tipsBody .items li label {\n  position: absolute;\n  left: 0;\n}\n\n.tipsBody .items li span {\n}\n\n.cancel,\n.confirm,\n.closeButton {\n  cursor: pointer;\n}\n\n.alertMask {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  z-index: 8888;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  pointer-events: none;\n}\n.alertBox {\n  padding: 10px;\n  min-width: 106px;\n  max-width: 306px;\n  min-height: 20px;\n  font-size: 16px;\n  border-radius: 5px;\n  display: flex;\n  /* align-items: center; */\n  flex-direction: row;\n  transition: all 1s;\n  opacity: 0;\n}\n\n.alertShow {\n  animation: showOpacity 3s;\n  animation-fill-mode: forwards;\n}\n\n@keyframes showOpacity {\n  0% {\n    opacity: 0;\n  }\n  25% {\n    opacity: 1;\n  }\n  50% {\n    opacity: 1;\n  }\n  75% {\n    opacity: 1;\n  }\n  100% {\n    opacity: 0;\n  }\n}\n\n.alertBox img {\n  width: 18px;\n  height: 18px;\n  padding: 1px 10px;\n}\n.alertContent {\n  display: inline-block;\n  overflow: hidden;\n  font-size: 16px;\n}\n\n.listingInfo {\n  width: 160px;\n  height: 40px;\n  text-align: center;\n  position: fixed;\n  top: 400px;\n  height: 600px;\n  color: red;\n  font-weight: bold;\n  font-size: 30px;\n  line-height: 40px;\n  background-color: rgba(56, 56, 0, 0.3);\n  border: 2px solid #ffff00;\n}\n\n/*\n* 网元tips样式\n*/\n.postalTips {\n  border-radius: 5px;\n  position: absolute;\n  padding: 5px;\n  background-color: #eee;\n  box-sizing: border-box;\n  display: none;\n  z-index: 999;\n}\n.postalTips .after {\n  content: \"\";\n  position: absolute;\n  width: 0;\n  height: 0;\n  border-style: solid;\n  border-width: 5px 5px 0 5px;\n  border-color: #eee transparent transparent;\n}\n\n.iframeMask {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background-color: rgba(0, 0, 0, 0.7);\n  z-index: 9999;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n}\n\n.maplistHead {\n  border-radius: 5px 5px 0 0;\n  height: 30px;\n  line-height: 30px;\n  background-color: #00b3ee;\n  color: #fff;\n  font-size: 12px;\n  padding-left: 22px;\n  display: flex;\n  justify-content: flex-end;\n}\n\n.maplistHead i {\n  margin-right: 15px;\n  cursor: pointer;\n}\n\n.htmlNode {\n  position: absolute;\n  top: 0;\n  left: 0;\n  background-color: #2d3e50;\n  overflow: hidden;\n  transform-origin: 0px 0px;\n  display: flex;\n  flex-direction: column;\n}\n\n.htmlTableNode {\n  background-color: transparent !important;\n  border-radius: 6px;\n  overflow: visible;\n  border: 3px solid transparent;\n}\n\n.htmlTableNode.htmlNodeSelected {\n  border: 3px solid #0095ff;\n  border-radius: 6px;\n  box-shadow: 0 0 5px #aedeff;\n}\n\n.htmlTableNodeHeader {\n  height: 50px;\n  margin-bottom: 4px;\n  border-radius: 6px;\n  background-color: rgba(14, 39, 55, 0.5);\n  line-height: 50px;\n  font-size: 20px;\n  color: #dfeff9;\n  text-indent: 20px;\n  position: relative;\n}\n\n.htmlTableNodePager {\n  /* height: 40px; */\n  height: 0;\n}\n\n.htmlTableNodeBody {\n  flex: 1;\n  position: relative;\n  border-radius: 6px;\n  background-color: rgba(10, 30, 40, 0.5);\n  overflow: hidden;\n}\n.tableDataDiv {\n  display: flex;\n  flex-direction: column;\n  width: 100% !important;\n  height: auto !important;\n}\n.htmlTableRow {\n  position: relative !important;\n  top: 0 !important;\n  line-height: 36px !important;\n  height: 36px !important;\n  border-width: 0px !important;\n  display: flex;\n  width: 100% !important;\n}\n\n.htmlTableCell {\n  position: relative !important;\n  top: 0 !important;\n  left: 0 !important;\n  height: 36px !important;\n  line-height: 36px !important;\n  color: #fefafa !important;\n}\n\n.htmlTableRow:nth-child(odd) {\n  background-color: rgba(15, 41, 58, 0.6);\n}\n.htmlNode .editBlock {\n  visibility: hidden;\n}\n\n.htmlNode.htmlNodeSelected .editBlock {\n  visibility: visible;\n}\n\n.htmlNode .editBlock > div {\n  position: absolute;\n  height: 60px;\n  width: 60px;\n  border: 60px solid red;\n  background-color: red;\n  transform: translate(-50%, -50%);\n}\n\n.htmlTableNodeMask {\n  width: 100%;\n  height: 100%;\n  pointer-events: none;\n  position: absolute;\n}\n.htmlTableNodeTotalIcon {\n  display: none;\n  position: absolute;\n  top: 0;\n  right: 0;\n}\n\n/* htmltable 搜索框样式 */\n.tableSelect {\n  display: none;\n  width: auto;\n  height: 30px;\n  margin: 2px;\n  border: 2px solid rgba(57, 111, 255, 0.2);\n  background: rgba(57, 111, 255, 0.1);\n  align-items: center;\n  position: relative;\n}\n.tableSelect input {\n  color: rgba(57, 111, 255, 1);\n  outline: none;\n  background: rgba(0, 0, 0, 0);\n  height: 100%;\n  width: 100%;\n  border: none;\n  padding-right: 30px;\n  padding-left: 5px;\n}\n.tableSelect .selectIcon {\n  position: absolute;\n  right: 4px;\n  top: 2px;\n  height: 26px;\n  width: 26px;\n  background-size: 26px 26px;\n  background-repeat: no-repeat;\n  background-image: url(\"../image/icons/tableSelect.svg\");\n}\n\n\n.tablePaneHeader {\n  height: 40px !important;\n  position: initial !important;\n  text-align: center !important;\n  background-color: transparent !important;\n}\n\n.tableViewDiv {\n  position: initial !important;\n  text-align: center !important;\n}\n\n.tablePaneHeader div {\n  height: 40px !important;\n  line-height: 40px !important;\n  background-color: transparent !important;\n  border-color: transparent !important;\n  color: #21b7d7 !important;\n  font-size: 16px !important;\n}\n\n.tableDataDiv,\n.tableRootDiv {\n  position: initial !important;\n}\n\n.tablePaneBody {\n  display: flex !important;\n  flex-direction: column;\n}\n\n.tableViewDiv {\n  flex: 1;\n}\n\n.tableRootDiv {\n  height: 100%;\n  overflow-y: auto;\n}\n\n.tableRootDiv::-webkit-scrollbar-thumb {\n  border-radius: 10px;\n  box-shadow: inset 0 0 5px rgba(255, 255, 255, 0.2);\n  background: rgba(48, 255, 255, 0.2);\n}\n::-webkit-scrollbar-thumb {\n  border-radius: 10px;\n  box-shadow: inset 0 0 5px rgba(255, 255, 255, 0.2);\n  background: rgba(48, 255, 255, 0.2);\n}\n::-webkit-scrollbar {\n  width: 4px;\n  height: 4px;\n}\n.tableRootDiv::-webkit-scrollbar {\n  width: 4px;\n  height: 4px;\n}\n\n.htmlTableRow:nth-child(odd) {\n  background-color: rgba(15, 41, 58, 0.6);\n}\n/* textarea样式 */\n.component-textarea{\n  min-height: 50px;\n}"
