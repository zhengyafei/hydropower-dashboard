html {
  overflow: hidden;
}

body {
  margin: 0;
  position: relative;
}

.app {
  width: 100vw;
  height: 100vh;
  display: flex;
}

.rulerCanvas {
  display: block;
  height: 100%;
  width: 100%;
}

.topRuler {
  height: 20px;
  margin-left: 20px;
}

.leftRuler {
  width: 20px;
}

.view {
  flex: 1;
  display: none;
  flex-direction: column;
}

.networkWrap {
  display: flex;
  flex: 1;
  flex-direction: column;
  background-color: #202c38;
}

.canvasWrap {
  flex: 1;
  display: flex;
}

.leftRuler {
  width: 20px;
}

.network {
  flex: 1;
  height: 100%;
  position: relative;
  background-color: #dce5ec;
}

.chartDom {
  width: 100%;
  height: 100%;
}

.chartWrap {
  position: absolute;
  top: 0;
  left: 0;
  background-color: #2d3e50;
  overflow: hidden;
  transform-origin: 0px 0px;
  /* resize: both; */
}

.resizerWrap {
  width: 10px;
  height: 10px;
  position: absolute;
  right: 0;
  bottom: 0;
  border-bottom-color: inherit;
}

.resizer {
  border-color: #fff;
  position: absolute;
  right: 0;
  bottom: 0;
  width: 0;
  height: 0;
  border-bottom: 10px solid #fff;
  border-left: 10px solid transparent;
  overflow: hidden;
  background-color: transparent;
  cursor: nwse-resize;
}

.resizer2 {
  border-width: 9px;
  border-bottom-color: inherit;
}

.resizer3 {
  border-width: 5px;
}

.resizer4 {
  border-width: 4px;
  border-bottom-color: inherit;
}

.controlPanelWrap {
  /* height: 200px; */
  background-image: linear-gradient(to right, #181818, #383838, #181818);
  padding: 0 15px;
  border-radius: 4px;
  overflow: hidden;
  color: #eee;
}
.controlPanelWrap .closeButton {
  float: right;
}
#saveControlValue {
  padding: 0 16px;
  height: 30px;
  line-height: 30px;
  color: #eee;
  border: none;
  cursor: pointer;
  opacity: 0.8;
  float: right;
  background-color: #409eff;
  border-radius: 3px;
}

.controlRow {
  display: flex;
  margin-bottom: 10px;
  line-height: 30px;
  justify-content: space-between;
}

.controlRow.btnRow {
  display: flow-root;
}

.controlName {
  line-height: 30px;
  margin-right: 15px;
}

.controlInput {
  width: 120px;
  height: 30px;
  line-height: 30px;
}

#mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 9999;
  display: flex;
  justify-content: center;
  align-items: center;
}

.buttonMask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
  z-index: 9999;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
}
.buttonTitle {
  color: #ddd;
}
.buttonTitle span {
  display: inline-block;
  margin: 10px;
}
.buttonTitle i {
  float: right;
  margin: 10px;
}
.buttonPanel .buttonContent {
  width: 240px;
  color: #ddd;
  margin: 10px 15px;
}
.buttonPanel .buttonFooter {
  margin: 10px 15px;
  display: flex;
  justify-content: flex-end;
}
.buttonPanel .buttonFooter .cancel {
  padding: 0 16px;
  margin: 0 10px;
  border: 1px solid #eee;
  color: #eee;
  background: transparent;
  border-radius: 3px;
  height: 30px;
  line-height: 30px;
  opacity: 0.8;
}
.buttonPanel .buttonFooter .confirm {
  padding: 0 16px;
  height: 30px;
  line-height: 30px;
  color: #eee;
  border: none;
  cursor: pointer;
  opacity: 0.8;
  float: left;
  background-color: #409eff;
  border-radius: 3px;
}

.buttonPanel {
  /* width: 160px; */
  max-width: 280px;
  /* background-color: #fff; */
  background-image: linear-gradient(to right, #181818, #383838, #181818);
  border-radius: 4px;
}

.buttonPanelBtn {
  padding: 0 16px;
  height: 30px;
  line-height: 30px;
  color: #fff;
  border: none;
  cursor: pointer;
  margin: 10px;
  opacity: 0.8;
  float: left;
  background-color: #409eff;
}

.buttonPanelBtn:hover {
  opacity: 1;
}

/*
* 网元tips样式
*/
.tips {
  min-width: 140px;
  min-height: 37px;
  border-radius: 10px;
  box-shadow: 4px 4px 3px rgba(20%, 20%, 40%, 0.5);
  position: absolute;
  padding: 10px;
  background-color: #eee;
  box-sizing: border-box;
  display: none;
  z-index: 999;
}
.tips::after {
  content: "";
  position: absolute;
  width: 0;
  height: 0;
  border-style: solid;
}

.tips.leftTop::after {
  border-width: 20px 0 0 15px;
  border-color: #eee transparent transparent;
  bottom: -20px;
  right: 10px;
  box-shadow: 7px 0px 3px -3px rgba(20%, 20%, 40%, 0.5);
}

.tips.leftBottom::after {
  border-width: 0 0 20px 15px;
  border-color: transparent transparent #eee;
  top: -20px;
  right: 10px;
}

.tips.rightBottom::after {
  border-width: 20px 0 0 15px;
  border-color: transparent transparent transparent #eee;
  top: -20px;
  left: 10px;
}

.tips.rightTop::after {
  border-width: 20px 15px 0 0;
  border-color: #eee transparent transparent;
  bottom: -20px;
  left: 10px;
  box-shadow: -5px 0px 5px -4px rgba(20%, 20%, 40%, 0.5);
}

.tipsBody .items {
  list-style: none;
  margin: 0;
  padding: 0;
}

.tipsBody .items li {
  position: relative;
  /* padding-left: 43px; */
  height: 17px;
  line-height: 17px;
  font-size: 14px;
}

.tipsBody .items li.noData {
  padding-left: 0;
  color: #797777;
}

.tipsBody .items li label {
  position: absolute;
  left: 0;
}

.tipsBody .items li span {
}

.cancel,
.confirm,
.closeButton {
  cursor: pointer;
}

.alertMask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 8888;
  display: flex;
  justify-content: center;
  align-items: center;
  pointer-events: none;
}
.alertBox {
  padding: 10px;
  min-width: 106px;
  max-width: 306px;
  min-height: 20px;
  font-size: 16px;
  border-radius: 5px;
  display: flex;
  /* align-items: center; */
  flex-direction: row;
  transition: all 1s;
  opacity: 0;
}

.alertShow {
  animation: showOpacity 3s;
  animation-fill-mode: forwards;
}

@keyframes showOpacity {
  0% {
    opacity: 0;
  }
  25% {
    opacity: 1;
  }
  50% {
    opacity: 1;
  }
  75% {
    opacity: 1;
  }
  100% {
    opacity: 0;
  }
}

.alertBox img {
  width: 18px;
  height: 18px;
  padding: 1px 10px;
}
.alertContent {
  display: inline-block;
  overflow: hidden;
  font-size: 16px;
}

.listingInfo {
  width: 160px;
  height: 40px;
  text-align: center;
  position: fixed;
  top: 400px;
  height: 600px;
  color: red;
  font-weight: bold;
  font-size: 30px;
  line-height: 40px;
  background-color: rgba(56, 56, 0, 0.3);
  border: 2px solid #ffff00;
}

/*
* 网元tips样式
*/
.postalTips {
  border-radius: 5px;
  position: absolute;
  padding: 5px;
  background-color: #eee;
  box-sizing: border-box;
  display: none;
  z-index: 999;
}
.postalTips .after {
  content: "";
  position: absolute;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 5px 5px 0 5px;
  border-color: #eee transparent transparent;
}

.iframeMask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
  z-index: 9999;
  display: flex;
  justify-content: center;
  align-items: center;
}

.maplistHead {
  border-radius: 5px 5px 0 0;
  height: 30px;
  line-height: 30px;
  background-color: #00b3ee;
  color: #fff;
  font-size: 12px;
  padding-left: 22px;
  display: flex;
  justify-content: flex-end;
}

.maplistHead i {
  margin-right: 15px;
  cursor: pointer;
}

.htmlNode {
  position: absolute;
  top: 0;
  left: 0;
  background-color: #2d3e50;
  overflow: hidden;
  transform-origin: 0px 0px;
  display: flex;
  flex-direction: column;
}

.htmlTableNode {
  background-color: transparent !important;
  border-radius: 6px;
  overflow: visible;
  border: 3px solid transparent;
}

.htmlTableNode.htmlNodeSelected {
  border: 3px solid #0095ff;
  border-radius: 6px;
  box-shadow: 0 0 5px #aedeff;
}

.htmlTableNodeHeader {
  height: 50px;
  margin-bottom: 4px;
  border-radius: 6px;
  background-color: rgba(14, 39, 55, 0.5);
  line-height: 50px;
  font-size: 20px;
  color: #dfeff9;
  text-indent: 20px;
  position: relative;
}

.htmlTableNodePager {
  /* height: 40px; */
  height: 0;
}

.htmlTableNodeBody {
  flex: 1;
  position: relative;
  border-radius: 6px;
  background-color: rgba(10, 30, 40, 0.5);
  overflow: hidden;
}
.tableDataDiv {
  display: flex;
  flex-direction: column;
  width: 100% !important;
  height: auto !important;
}
.htmlTableRow {
  position: relative !important;
  top: 0 !important;
  line-height: 36px !important;
  height: 36px !important;
  border-width: 0px !important;
  display: flex;
  width: 100% !important;
}

.htmlTableCell {
  position: relative !important;
  top: 0 !important;
  left: 0 !important;
  height: 36px !important;
  line-height: 36px !important;
  color: #fefafa !important;
}

.htmlTableRow:nth-child(odd) {
  background-color: rgba(15, 41, 58, 0.6);
}
.htmlNode .editBlock {
  visibility: hidden;
}

.htmlNode.htmlNodeSelected .editBlock {
  visibility: visible;
}

.htmlNode .editBlock > div {
  position: absolute;
  height: 60px;
  width: 60px;
  border: 60px solid red;
  background-color: red;
  transform: translate(-50%, -50%);
}

.htmlTableNodeMask {
  width: 100%;
  height: 100%;
  pointer-events: none;
  position: absolute;
}
.htmlTableNodeTotalIcon {
  display: none;
  position: absolute;
  top: 0;
  right: 0;
}

/* htmltable 搜索框样式 */
.tableSelect {
  display: none;
  width: auto;
  height: 30px;
  margin: 2px;
  border: 2px solid rgba(57, 111, 255, 0.2);
  background: rgba(57, 111, 255, 0.1);
  align-items: center;
  position: relative;
}
.tableSelect input {
  color: rgba(57, 111, 255, 1);
  outline: none;
  background: rgba(0, 0, 0, 0);
  height: 100%;
  width: 100%;
  border: none;
  padding-right: 30px;
  padding-left: 5px;
}
.tableSelect .selectIcon {
  position: absolute;
  right: 4px;
  top: 2px;
  height: 26px;
  width: 26px;
  background-size: 26px 26px;
  background-repeat: no-repeat;
  background-image: url("../image/icons/tableSelect.svg");
}


.tablePaneHeader {
  height: 40px !important;
  position: initial !important;
  text-align: center !important;
  background-color: transparent !important;
}

.tableViewDiv {
  position: initial !important;
  text-align: center !important;
}

.tablePaneHeader div {
  height: 40px !important;
  line-height: 40px !important;
  background-color: transparent !important;
  border-color: transparent !important;
  color: #21b7d7 !important;
  font-size: 16px !important;
}

.tableDataDiv,
.tableRootDiv {
  position: initial !important;
}

.tablePaneBody {
  display: flex !important;
  flex-direction: column;
}

.tableViewDiv {
  flex: 1;
}

.tableRootDiv {
  height: 100%;
  overflow-y: auto;
}

.tableRootDiv::-webkit-scrollbar-thumb {
  border-radius: 10px;
  box-shadow: inset 0 0 5px rgba(255, 255, 255, 0.2);
  background: rgba(48, 255, 255, 0.2);
}
::-webkit-scrollbar-thumb {
  border-radius: 10px;
  box-shadow: inset 0 0 5px rgba(255, 255, 255, 0.2);
  background: rgba(48, 255, 255, 0.2);
}
::-webkit-scrollbar {
  width: 4px;
  height: 4px;
}
.tableRootDiv::-webkit-scrollbar {
  width: 4px;
  height: 4px;
}

.htmlTableRow:nth-child(odd) {
  background-color: rgba(15, 41, 58, 0.6);
}
/* textarea样式 */
.component-textarea{
  min-height: 50px;
}