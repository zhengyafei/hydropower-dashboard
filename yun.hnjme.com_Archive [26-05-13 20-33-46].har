            "text": "{\"code\":200,\"msg\":\"\",\"uri\":null,\"body\":{\"total\":1,\"size\":10,\"current\":1,\"records\":[{\"pid\":\"23112110045523\",\"eventName\":\"2#机组碳刷烧损\",\"eventAddress\":\"主厂房\",\"userId\":\"22042013372128\",\"eventUserName\":\"炎陵-常兴明\",\"companyId\":\"20070810283601\",\"eventTime\":\"1700107680\",\"eventDesc\":\"2023年11月16日12点25分中心接龙泉电站值守陈运福来电告知2#机组碳刷打火，集电环烧了。\\n经查视频监控证实：2023年11月16日凌晨大约3点，2#机组碳刷有轻微打火，至7点钟有明显打火和弧光闪烁，至中午12点09分碳刷烧损后机组保护动作自动停机，整个过程持续9个多小时。由最初的轻微打火演变形成环火并产生高温，最终导致碳刷烧损。\",\"optWay\":\"设备事故停机，长沙值班中心值班人员通知现场值守人员去现场检查\",\"optWayNext\":\"通知运维中心人员去处理\",\"createTime\":\"1700533104\",\"fileCount\":0,\"companyName\":\"炎陵龙泉水电站\",\"companyCode\":\"HN_ZZ_LQ\",\"userName\":\"炎陵-常兴明\",\"status\":\"end\",\"procInstId\":\"134009\",\"procDefId\":\"HN_ZZ_LQ.eventFirstReport:1:68004\",\"workflowOpinionList\":null,\"signUserList\":null,\"taskId\":null,\"assignee\":\"21052511341818\",\"assigneeName\":\"蒋传家\",\"formKey\":null}],\"pages\":1},\"success\":true}"
