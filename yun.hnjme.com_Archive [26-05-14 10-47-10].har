            "text": ".record-query {\n  padding-left: 20px;\n}\n.record-query .query-type,\n.record-query .query-form {\n  display: -webkit-box;\n  display: -ms-flexbox;\n  display: flex;\n  text-align: left;\n  margin-bottom: 30px;\n}\n.record-query .number-count {\n  width: 22px;\n  height: 22px;\n  background: rgba(0, 197, 135, 0.3);\n  color: #fff;\n  text-align: center;\n  border-radius: 2px;\n  cursor: pointer;\n}\n.onduty-record-query-detail-dialog .el-dialog__header {\n  -webkit-box-align: start;\n      -ms-flex-align: start;\n          align-items: flex-start;\n}\n.onduty-record-query-detail-dialog .top-detail {\n  -webkit-box-flex: 1;\n      -ms-flex: 1;\n          flex: 1;\n}\n.onduty-record-query-detail-dialog .top-detail .row {\n  display: -webkit-box;\n  display: -ms-flexbox;\n  display: flex;\n  text-align: left;\n}\n.onduty-record-query-detail-dialog .top-detail .row .item {\n  width: 20%;\n}\n.onduty-record-query-detail-dialog .top-detail .row .item .title {\n  display: block;\n  font-size: 14px;\n  font-family: PingFang SC;\n  font-weight: 400;\n  color: rgba(255, 255, 255, 0.5);\n}\n.onduty-record-query-detail-dialog .top-detail .row .item .value {\n  font-size: 18px;\n  font-family: PingFang-SC-Bold;\n  font-weight: bold;\n  color: #fff;\n}\n.onduty-record-query-detail-dialog .el-dialog__body {\n  padding: 0 20px;\n}\n.onduty-record-query-detail-dialog .number-count {\n  width: 22px;\n  height: 22px;\n  background: rgba(0, 197, 135, 0.3);\n  color: #fff;\n  text-align: center;\n  border-radius: 2px;\n  cursor: pointer;\n}\n\n"
